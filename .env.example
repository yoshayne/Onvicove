# ── Railway (auto-injected — do NOT set manually in Railway) ──
DATABASE_URL=postgresql://user:pass@host:5432/dbname
REDIS_URL=redis://default:pass@host:6379

# ── Railway Object Storage (copy from Railway dashboard) ──
BUCKET_NAME=
BUCKET_ENDPOINT_URL=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto

# ── App ──
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173

# ── Clerk ──
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
VITE_CLERK_PUBLISHABLE_KEY=

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Second Stripe webhook: "Listen to events on Connected accounts" -> payment_intent.succeeded / payment_failed
STRIPE_CONNECT_WEBHOOK_SECRET=
# direct (default: store is merchant of record, platform takes an application fee) | destination (old behaviour)
STRIPE_CHARGE_MODEL=direct

# ── Brevo ──
BREVO_API_KEY=

# ── AI Photos ──
GEMINI_API_KEY=

# ── Platform config ──
# Direct charges: your cut on top of Stripe's own 2.9% + 30c (paid by the store). Business defaults to 0.01.
PLATFORM_APP_FEE_PERCENT=0.02
PLATFORM_APP_FEE_FIXED_CENTS=0
# Only used when STRIPE_CHARGE_MODEL=destination
PLATFORM_FEE_PERCENT=0.049
PLATFORM_FEE_FIXED_CENTS=30
AI_PHOTO_COST_CENTS=299
